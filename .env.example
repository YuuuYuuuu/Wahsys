# MySQL (MAMP + phpMyAdmin). Buat database `wahsys` di phpMyAdmin dulu.
# Port umum MAMP: 8889 atau 3306 — cek di MAMP → Preferences → Ports.
DATABASE_URL="mysql://root:root@127.0.0.1:8889/wahsys"
# Contoh jika MySQL di 3306:
# DATABASE_URL="mysql://root:root@127.0.0.1:3306/wahsys"

JWT_SECRET="change-me-min-32-chars-random-string-here"
JWT_ACCESS_EXPIRES="15m"
REFRESH_TOKEN_DAYS="7"
REFRESH_PEPPER="change-me-pepper-for-refresh-hash"
ALLOW_PUBLIC_REGISTER="true"
NODE_ENV="development"

# Optional: Upstash for distributed rate limiting (omit for dev single-instance fallback)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3-compatible storage (MinIO / AWS / R2). Kosongkan = gambar barang lokal di public/uploads/items;
# lampiran vault terenkripsi lokal di public/uploads/credentials (fallback bila presign 503).
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="wahsys"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL=""

# Base URL for email links (loan confirmation, etc.)
APP_URL="http://localhost:3000"
# Optional display name in emails
APP_NAME="WahSys"

# Kustomisasi Branding & Identitas (Opsional)
NEXT_PUBLIC_APP_NAME="WahSys"
NEXT_PUBLIC_APP_TAGLINE="Sistem Terpadu Manajemen Operasional & Aset"
# URL / path logo di kiri atas (contoh: "/logo.png" atau "https://domain.com/logo.png")
NEXT_PUBLIC_APP_LOGO_URL=""
# URL / path icon browser tab / favicon (contoh: "/favicon.ico" atau "https://domain.com/icon.png")
NEXT_PUBLIC_APP_ICON_URL=""

# AES key for encrypting SMTP password in DB (64 hex chars = 32 bytes)
SMTP_CREDENTIALS_KEY=""

# Bearer secret for POST /api/cron/loan-reminders (Vercel Cron / external curl)
CRON_SECRET=""
